# Names only here; never commit real values. Three git-ignored files, split by who may hold them (D-034).
# Service credentials are generated by: python scripts/make_env.py   (keeps your API key lines as they are)

# ---------------------------------------------------------------- .env.local: every process, including sessions
LEXARENA_CONFIG_PATH=config/config.v1.yaml
# LLM keys: config/config.vN.yaml names which variable each role reads (models.<role>.api_key_env)
Groq_API1=<groq key>
Groq_API2=<groq key>
Groq_API3=<groq key>
Groq_API4=<groq key>
gemini_api=<gemini key>
LEXARENA_MONGO_APP_DB=lexarena
LEXARENA_MONGO_APP_URI=mongodb://lexarena_app:<password>@127.0.0.1:27017/lexarena?authSource=lexarena
LEXARENA_QDRANT_URL=http://127.0.0.1:6333
LEXARENA_QDRANT_READ_ONLY_API_KEY=<random>
LEXARENA_REDIS_URL=redis://:<password>@127.0.0.1:6379/0

# ---------------------------------------------------------------- .env.sealed: clerk, ingestion, evaluator, reflection only
# LEXARENA_MONGO_SEALED_DB=lexarena_sealed
# LEXARENA_MONGO_SEALED_URI=mongodb://lexarena_sealed:<password>@127.0.0.1:27017/lexarena_sealed?authSource=lexarena_sealed
# LEXARENA_QDRANT_WRITE_API_KEY=<random>

# ---------------------------------------------------------------- .env.docker: docker compose only, never Python
# LEXARENA_MONGO_ROOT_USER, LEXARENA_MONGO_ROOT_PASSWORD, LEXARENA_MONGO_APP_DB, LEXARENA_MONGO_APP_USER,
# LEXARENA_MONGO_APP_PASSWORD, LEXARENA_MONGO_SEALED_DB, LEXARENA_MONGO_SEALED_USER, LEXARENA_MONGO_SEALED_PASSWORD,
# LEXARENA_QDRANT_SERVER_API_KEY, LEXARENA_QDRANT_SERVER_READ_ONLY_API_KEY, LEXARENA_REDIS_PASSWORD
