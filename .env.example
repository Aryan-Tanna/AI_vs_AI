# Copy to .env.local (git-ignored) and fill in. Names only here; never commit real values.

# Which config version this machine runs
LEXARENA_CONFIG_PATH=config/config.v1.yaml

# LLM keys: config/config.vN.yaml names which variable each role reads (models.<role>.api_key_env)
Groq_API1=<groq key>
Groq_API2=<groq key>
Groq_API3=<groq key>
Groq_API4=<groq key>
gemini_api=<gemini key>

# Local services (docker compose --env-file .env.local up -d)
LEXARENA_MONGO_ROOT_USER=lexarena_root
LEXARENA_MONGO_ROOT_PASSWORD=<random>
LEXARENA_MONGO_APP_DB=lexarena
LEXARENA_MONGO_APP_USER=lexarena_app
LEXARENA_MONGO_APP_PASSWORD=<random>
LEXARENA_MONGO_SEALED_DB=lexarena_sealed
LEXARENA_MONGO_SEALED_USER=lexarena_sealed
LEXARENA_MONGO_SEALED_PASSWORD=<random>
LEXARENA_MONGO_APP_URI=mongodb://lexarena_app:<password>@127.0.0.1:27017/lexarena?authSource=lexarena
LEXARENA_MONGO_SEALED_URI=mongodb://lexarena_sealed:<password>@127.0.0.1:27017/lexarena_sealed?authSource=lexarena_sealed
LEXARENA_QDRANT_URL=http://127.0.0.1:6333
LEXARENA_REDIS_URL=redis://127.0.0.1:6379/0
