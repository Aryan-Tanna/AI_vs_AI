  "SC_AUTHORITY": "Supreme Court judgment kept only as a verified authority: a landmark models have memorised, or not an appeal (a writ petition)",
  "DUPLICATE": "Same judgment as another file",
  "OUT_OF_SCOPE": "Not an IBC proceeding (D-001); never clerked",
  "NO_MERITS": "One-page order disposing of the appeal without deciding it (withdrawn or not prosecuted); nothing to argue"
 },
